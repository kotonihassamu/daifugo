{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null && data.child('players/' + auth.uid).exists()",
        ".write": "auth != null && !newData.exists() && data.child('meta/updatedAt').val() < now - 86400000",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.parent().child('players/' + auth.uid).exists())",
          ".validate": "newData.hasChildren(['code', 'hostUid', 'createdAt'])",
          "hostUid": {
            ".validate": "newData.isString() && (newData.val() === auth.uid || newData.parent().parent().child('players/' + newData.val()).exists())"
          }
        },
        "rules": {
          ".write": "auth != null && (newData.parent().child('meta/hostUid').val() === auth.uid)"
        },
        "players": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && newData.parent().parent().child('meta').exists() && (auth.uid === $uid || (data.exists() && data.parent().child(auth.uid).exists()))",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8"
            }
          }
        },
        "game": {
          ".write": "auth != null && data.parent().child('players/' + auth.uid).exists() && (data.exists() || data.parent().child('meta/hostUid').val() === auth.uid)",
          ".validate": "newData.child('actor').val() === auth.uid && ((!data.exists() && newData.child('seq').val() === 1) || (data.exists() && newData.child('seq').val() === data.child('seq').val() + 1)) && (!data.exists() || data.child('status').val() !== 'playing' || data.child('turn').val() === auth.uid || data.child('pending/uid').val() === auth.uid || data.child('bombApply/waiting/' + auth.uid).exists() || data.parent().child('meta/hostUid').val() === auth.uid)"
        }
      }
    },
    "hands": {
      "$roomId": {
        ".write": "auth != null && !newData.exists() && root.child('roomIndex/' + $roomId + '/updatedAt').val() < now - 86400000",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $roomId + '/meta/hostUid').val() === auth.uid)"
        }
      }
    },
    "inbox": {
      "$roomId": {
        ".write": "auth != null && !newData.exists() && root.child('roomIndex/' + $roomId + '/updatedAt').val() < now - 86400000",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && root.child('rooms/' + $roomId + '/players/' + auth.uid).exists()"
        }
      }
    },
    "roomCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || (!newData.exists() && root.child('roomIndex/' + data.val() + '/updatedAt').val() < now - 86400000))",
        ".validate": "$code.matches(/^[0-9]{4}$/) && newData.isString()"
      }
    },
    "roomIndex": {
      ".read": "auth != null",
      ".indexOn": ["updatedAt"],
      "$roomId": {
        ".write": "auth != null && (newData.parent().parent().child('rooms/' + $roomId + '/players/' + auth.uid).exists() || (!newData.exists() && data.child('updatedAt').val() < now - 86400000))"
      }
    }
  }
}
